# 포트는 add-cto 배정 offset 파생 (RULES §4: 예 offset=N → 8000+N/5173+N)
PORT_OFFSET=
BACKEND_PORT=
FRONTEND_PORT=
HF_HOME=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/huggingface
RUNS_ROOT=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/dataset/runs
EVAL500_ROOT=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/dataset/psnr_ssim
FID500_ROOT=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/dataset/fid
FID_V2_ROOT=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/dataset/fid_v2
# 생성·측정 CLI. web/server.py가 --strength와 --run-id를 추가한다.
EVAL_CMD=.venv/bin/python scripts/run_eval.py
TRY_CMD=.venv/bin/python scripts/try_generate.py
FID_CMD=.venv/bin/python scripts/run_fid_eval.py
FID_V2_CMD=.venv/bin/python scripts/run_fid_v2_img2img_eval.py

# ── docker (compose 가 읽는 값) ─────────────────────────────────────────────
# 데이터는 호스트 경로 그대로 컨테이너에 mount 한다 — dataset 안 절대경로 기록과
# 어긋나지 않게 하기 위함. 경로가 다른 PC 로 옮기면 여기와 dataset 기록을 함께 치환.
DATASET_DIR=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/dataset
PILOT_DIR=/home/kim_3090/dev/harness-claude/claude-project/perf-eval-gen/runs/pilot
# 컨테이너 실행 uid/gid — run 산출물이 root 소유로 떨어지지 않게 (`id -u`, `id -g`).
DOCKER_UID=1000
DOCKER_GID=1000
